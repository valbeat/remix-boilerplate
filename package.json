{
	"private": true,
	"sideEffects": false,
	"type": "module",
	"volta": {
		"node": "22.14.0"
	},
	"engines": {
		"node": "22.x"
	},
	"packageManager": "pnpm@10.6.3",
	"scripts": {
		"build": "remix vite:build",
		"check": "biome check .",
		"check:apply": "biome check --apply --no-errors-on-unmatched --files-ignore-unknown=true .",
		"dev": "remix vite:dev",
		"start": "remix-serve ./build/server/index.js",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest",
		"test:ci": "vitest run",
		"test:update": "vitest --update",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --pretty --noEmit"
	},
	"dependencies": {
		"@remix-run/node": "^2.17.5",
		"@remix-run/react": "^2.17.5",
		"@remix-run/serve": "^2.17.5",
		"isbot": "^5.2.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@chromatic-com/storybook": "^4.1.1",
		"@remix-run/dev": "^2.17.5",
		"@storybook/addon-links": "^10.6.8",
		"@storybook/addon-onboarding": "^10.6.8",
		"@storybook/react": "^10.6.8",
		"@storybook/react-vite": "^10.6.8",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "16.3.0",
		"@types/node": "^24.9.1",
		"@types/react": "^18.3.11",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"autoprefixer": "^10.4.21",
		"happy-dom": "^21.0.4",
		"lefthook": "^2.0.0",
		"postcss": "^8.5.33",
		"storybook": "^10.6.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^6.4.5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.11"
	}
}
